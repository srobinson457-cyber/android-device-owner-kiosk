# Copy to keystore.properties (which is gitignored) and fill in.
#
# Keep the keystore file itself OUTSIDE the project tree. Once this package is Device
# Owner on a device, a differently-signed APK cannot be installed over it without first
# clearing Device Owner, and clearing Device Owner on a provisioned device generally means
# a factory reset. Losing this key means losing the ability to update that device at all.
#
# Back it up somewhere that survives the loss of your development machine.

storeFile=/absolute/path/outside/this/repo/release-upload.keystore
storePassword=
keyAlias=
keyPassword=
